# Preserve the existing .gitignore exclusions.
# EAS uses this file instead of .gitignore when preparing build uploads.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# User-uploaded reference assets (not used by app)
attached_assets/

# Workspace-only tool caches, CLI installations, and agent metadata.
# In particular, dotslash caches can contain read-only DevTools directories.
/.cache/
/.config/
/.local/
/.agents/

# Local credentials are not part of the app source upload.
*.keystore
credentials.json
.env
.env.*